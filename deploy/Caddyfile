# Boatsdoc — HTTPS-Zertifikate holt Caddy automatisch (Let's Encrypt), sobald die Namen auf den Server zeigen.
# neu.{{DOMAIN}} ist zum Testen vor dem Umstellen der Hauptdomain gedacht.

{{DOMAIN}}, neu.{{DOMAIN}} {
	encode zstd gzip
	request_body {
		max_size 160MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	reverse_proxy 127.0.0.1:8080
}

www.{{DOMAIN}} {
	redir https://{{DOMAIN}}{uri} permanent
}
